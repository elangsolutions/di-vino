# Copy this file to .env and adjust values for your environment.

PORT=3000

# MongoDB connection string.
# Local Docker instance: docker run -d --name di-vino-mongo -p 27017:27017 mongo:7
MONGO_URI=mongodb://localhost:27017/di-vino

# Pipe-separated list of allowed frontend origins for CORS.
FRONTEND_URLS=http://localhost:5173

# Mercado Pago integration (leave disabled unless you have real credentials).
MP_ENABLED=false
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Payment flow mode:
# - live: real Mercado Pago QR checkout
# - testing: bypass payment provider; create orders as paid
PAYMENT_MODE=testing

DIVINO_APP=
